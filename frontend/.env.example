# Copy this file to .env.local and fill in your values.
# NEXT_PUBLIC_* values are bundled into the browser: never put secrets here.

# Backend API and Socket.io URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# WhatsApp Embedded Signup (only needed for the Integrations page)
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=
NEXT_PUBLIC_WHATSAPP_REDIRECT_URI=
NEXT_PUBLIC_WEBHOOK_PUBLIC_URL=
