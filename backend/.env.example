# Copy this file to .env and fill in your values.
# Only the "Core" section is needed to start the API locally.

# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/support-saas
# 32+ characters in production. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# Optional: defaults to a key derived from JWT_SECRET. 64 hex characters recommended.
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
# Comma-separated extra dashboard origins. API-key endpoints accept any origin.
CORS_ORIGINS=
PUBLIC_API_URL=http://localhost:5000
ALLOW_PUBLIC_SIGNUP=false
# debug | info | warn | error
LOG_LEVEL=debug

# ── First admin (npm run seed:super-admin) ──────────────────────────────
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=change-me
SEED_USER_FIRST_NAME=Super
SEED_USER_LAST_NAME=Admin
# admin | company-admin | staff (company roles also need SEED_USER_COMPANY)
SEED_USER_ROLE=admin
SEED_USER_COMPANY=

# ── AI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
HF_TOKEN=
HF_EMBEDDING_MODEL=google/embeddinggemma-300m
HF_PROVIDER=hf-inference
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_INDEX_HOST=
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0

# ── WhatsApp (Meta Cloud API) ───────────────────────────────────────────
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_OAUTH_REDIRECT_URI=
WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_VERIFY_SIGNATURE=true
WEBHOOK_PUBLIC_URL=

# ── Email (invitations) ─────────────────────────────────────────────────
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
INVITATION_JWT_SECRET=
INVITATION_EXPIRES_IN=24h

# ── Storage (Backblaze B2, S3-compatible) ───────────────────────────────
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_REGION=us-west-004
B2_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_BUCKET_NAME=
B2_PUBLIC_URL_BASE=

# ── AI design studio ────────────────────────────────────────────────────
REPLICATE_API_TOKEN=
DESIGN_VISION_ENABLED=true
INNGEST_LOCAL_PORT=4001
